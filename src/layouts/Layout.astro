---
import '../styles/global.css';
import { t, url, page, type Lang } from '../data/i18n';
interface Props { lang: Lang; title?: string; path?: string }
const { lang, title, path = '' } = Astro.props;
const u = t(lang);
const other: Lang = lang === 'en' ? 'si' : 'en';
const full = title ? `${title} · ${u.app}` : `${u.app} — ${u.tagline}`;
const nav = [['home', ''], ['check', 'check'], ['relief', 'relief'], ['log', 'log'], ['help', 'help']] as const;
const here = path;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{full}</title>
  <meta name="description" content={u.desc} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={u.desc} />
  <meta property="og:image" content={new URL(url('og.png'), Astro.site).href} />
  <meta name="theme-color" content="#4a5fd1" />
  <link rel="manifest" href={url('manifest.webmanifest')} />
  <link rel="icon" href={url('icon.svg')} type="image/svg+xml" />
  <link rel="apple-touch-icon" href={url('icon-192.png')} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700&family=Noto+Sans+Sinhala:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script is:inline>
    try { if (localStorage.getItem('cd-theme') === 'dark' || (!localStorage.getItem('cd-theme') && matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.classList.add('dark'); } catch (e) {}
  </script>
</head>
<body class="min-h-dvh pb-24 font-sans antialiased md:pb-0">
  <header class="mx-auto flex max-w-5xl items-center gap-3 px-5 py-5">
    <a href={page(lang)} class="flex items-center gap-2.5 text-lg font-semibold">
      <img src={url('icon.svg')} alt="" class="size-9" />{u.app}
    </a>
    <nav class="ml-auto hidden gap-1 text-sm md:flex" aria-label="Main">
      {nav.map(([k, p]) => <a href={page(lang, p)} aria-current={here === p ? 'page' : undefined} class="rounded-full px-3.5 py-2 hover:bg-calm-soft aria-[current=page]:bg-calm-soft aria-[current=page]:font-semibold aria-[current=page]:text-calm">{u.nav[k]}</a>)}
    </nav>
    <a href={page(other, path)} lang={other} class="ml-auto rounded-full px-3 py-2 text-sm font-medium hover:bg-calm-soft md:ml-2">{u.other}</a>
    <button id="theme" type="button" class="grid size-9 place-items-center rounded-full hover:bg-calm-soft" aria-label={u.theme}>
      <svg class="size-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8"/></svg>
      <svg class="hidden size-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2"/></svg>
    </button>
  </header>

  <main class="mx-auto max-w-5xl px-5"><slot /></main>

  <!-- bottom navigation on phones -->
  <nav class="fixed inset-x-0 bottom-0 z-30 grid grid-cols-5 border-t border-line bg-card/95 pb-[env(safe-area-inset-bottom)] text-[0.72rem] backdrop-blur md:hidden" aria-label="Main">
    {nav.map(([k, p]) => <a href={page(lang, p)} aria-current={here === p ? 'page' : undefined} class="px-1 py-3 text-center text-muted aria-[current=page]:font-semibold aria-[current=page]:text-calm">{u.nav[k]}</a>)}
  </nav>

  <footer class="mx-auto mt-16 max-w-5xl px-5 pb-10 text-sm text-muted">
    <p>{u.privacy}</p>
    <p class="mt-1">{u.footer} · <a class="underline" href="https://malingaprabhath7-maker.github.io/malinga-portfolio/">Portfolio</a> · <a class="underline" href="https://github.com/malingaprabhath7-maker/Stress-Management-">Source</a></p>
  </footer>
  <script>
    document.getElementById('theme')?.addEventListener('click', () => {
      const d = document.documentElement.classList.toggle('dark');
      try { localStorage.setItem('cd-theme', d ? 'dark' : 'light'); } catch { /* ignore */ }
    });
    if ('serviceWorker' in navigator) navigator.serviceWorker.register(import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'sw.js').catch(() => {});
  </script>
</body>
</html>
